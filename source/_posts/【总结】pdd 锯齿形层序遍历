给你二叉树的根节点 root ，返回其节点值的 锯齿形层序遍历 。（即先从左往右，再从右往左进行下一层遍历，以此类推，层与层之间交替进行）。

 

示例 1：


输入：root = [3,9,20,null,null,15,7]
输出：[[3],[20,9],[15,7]]
示例 2：

输入：root = [1]
输出：[[1]]
示例 3：

输入：root = []
输出：[]

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> zigzagLevelOrder(TreeNode root) {
        if(root == null) {
            return List.of();
        }

        List<List<Integer>> res = new ArrayList<>();
        Queue<TreeNode> nodeVals = new ArrayDeque<>();
        nodeVals.add(root);
        boolean rTol = false;
    
        while (!nodeVals.isEmpty()) {
            int num = nodeVals.size();
            List<Integer> vals = new ArrayList<>();
            while(num-- > 0){
                TreeNode cur = nodeVals.poll();
                vals.add(cur.val);
                
                if(cur.left != null){ nodeVals.add(cur.left);}
                if(cur.right != null){nodeVals.add(cur.right);}

            }
            if(rTol){
                Collections.reverse(vals);
            }
            rTol = !rTol;
            res.add(vals);
            
        }
        return res;
    }
}